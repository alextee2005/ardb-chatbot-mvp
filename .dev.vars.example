# Copy to `.dev.vars` for local `wrangler dev`. `.dev.vars` is gitignored.
# In production set each of these with: wrangler secret put <NAME>

# From BotFather. Rotate with /revoke if it has ever been pasted into a chat,
# an issue, a log or a screenshot.
TELEGRAM_BOT_TOKEN=

# A random string you invent. Telegram echoes it back on every webhook call in
# the X-Telegram-Bot-Api-Secret-Token header, which is how the Worker knows a
# request really came from Telegram.
#
# Telegram accepts 1-256 characters of A-Z a-z 0-9 _ - and nothing else: a
# space or a symbol is rejected with "secret token contains illegal
# characters", from setWebhook rather than from here, so the mistake surfaces
# a long way from its cause. `openssl rand -hex 32` is always valid.
TELEGRAM_WEBHOOK_SECRET=

# The private moderator group's chat ID (negative number for groups, e.g.
# -1001234567890). To find it: add the bot to the group, post one message
# there, then run the "Verify bot" GitHub Action -- or, locally,
#   TELEGRAM_BOT_TOKEN=... python tools/verify_bot.py
# which lists every chat the bot can currently see.
MODERATOR_CHAT_ID=

# Optional, and only needed when DRAFT_PROVIDER is "claude" in wrangler.jsonc.
# console.anthropic.com -> API keys. Billed per token.
#
# For the "github" route there is a cheaper option that needs no API key at
# all: a Claude subscription. Run `claude setup-token` on your own machine and
# add the output as a *repository secret* named CLAUDE_CODE_OAUTH_TOKEN. The
# drafting workflow prefers it over this key and draws on the subscription, so
# there is nothing to top up per question. That token is only ever used by
# GitHub Actions -- the Worker has no use for it.
#
# The default provider is "workers-ai", which runs on Cloudflare's own
# inference through the AI binding and needs no credential at all. Set
# DRAFT_PROVIDER to "none" for a moderator-written reply every time: the
# ticket, the card and the Edit button all work, a person writes the answer,
# and the bot delivers it. /health reports which provider is in effect.
ANTHROPIC_API_KEY=

# Only for DRAFT_PROVIDER "github". A fine-grained personal access token with
# Contents: write on this repository and NOTHING else -- that is the minimum
# repository_dispatch accepts. Scope it tightly: unlike the Claude key, a
# leak of this one lets someone change the bot's code and the published rates
# it quotes.
#   GitHub -> Settings -> Developer settings -> Personal access tokens ->
#   Fine-grained tokens -> Generate new token
#
# As a *repository secret* it must be called DISPATCH_TOKEN, not this name:
# GitHub refuses any secret name beginning with GITHUB_. The deploy workflow
# reads DISPATCH_TOKEN and sets it on the Worker as GITHUB_DISPATCH_TOKEN,
# which is the name src/config.ts reads. Cloudflare has no such restriction,
# so this file and the Worker both use the real name.
GITHUB_DISPATCH_TOKEN=

# Neon connection string, e.g.
# postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/ardb?sslmode=require
DATABASE_URL=

# Optional. Minutes of silence after which a customer's interaction is treated
# as over. The next question then starts a new conversation rather than being
# drafted as a follow-up, and the finished one gets an ended_at. Default 60.
# CONVERSATION_IDLE_MINUTES=60

# Optional. Quiet minutes after the last activity before the bot asks whether
# anything else is needed. Default 30. The conversation is then closed
# CONVERSATION_IDLE_MINUTES after that question was *sent*, so an abandoned
# interaction ends 90 minutes after the last activity on the defaults. The
# follow-up is never sent while a question is still unanswered.
# FOLLOWUP_MINUTES=30

# Optional. How long a closed conversation stays in the live tables before the
# weekly archive moves it into the history tables, and how many are moved per
# run. Defaults 7 and 200. The archive copies before it deletes and deletes
# only what it can prove it copied, so neither value can cause data loss.
# ARCHIVE_AFTER_DAYS=7
# ARCHIVE_BATCH_SIZE=200

# Optional. How long an archived interaction is kept before it is deleted
# outright. Default 10 years, measured from the date of the interaction rather
# than the day it was archived. Satisfaction results are deleted on the same
# clock, measured from when they were given.
# HISTORY_RETENTION_YEARS=10

# Optional. SLA thresholds in minutes; the defaults in wrangler.jsonc apply
# when these are absent or invalid.
# SLA_NUDGE_AFTER_MINUTES=10
# SLA_NUDGE_REPEAT_MINUTES=30
# SLA_MAX_NUDGES=3
# SLA_WARN_CUSTOMER_AFTER_MINUTES=45
