{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ardb-chatbot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Cloudflare's own inference. No credential of any kind -- the binding is
  // the access. 10,000 neurons a day are free, resetting at 00:00 UTC; past
  // that, drafting stops and the moderator writes the answer, which the card
  // says in as many words.
  "ai": { "binding": "AI" },

  // Chases tickets nobody has answered. Every five minutes is finer than the
  // 10-minute nudge threshold, so a late ticket is caught promptly rather
  // than waiting out a whole extra interval.
  // One Cron Trigger, every five minutes. What each invocation is actually
  // for is decided by `scheduledWork` in src/core/schedule.ts: follow-ups,
  // surveys and the SLA sweep every time, plus the archive on Sunday at 03:20
  // UTC with a retry at 03:50.
  //
  // Five minutes, not one: the follow-up is due 30 minutes after the last
  // activity, so this is already far more precise than the thing it times.
  // Every minute would be 1,440 invocations a day, each querying Postgres --
  // which on Neon's free tier never lets the compute scale to zero.
  //
  // One rather than three for two reasons, both learned the hard way. The
  // Workers Free plan allows 5 cron triggers per ACCOUNT, and three did not
  // fit alongside what this account already had. And matching `event.cron`
  // against string literals meant the schedule had to be written twice and
  // kept in step -- in a syntax where Cloudflare numbers the weekday 1 =
  // Sunday while crontab uses 0, so "17 3 * * 0" was rejected by the
  // schedules API only after the Worker had already uploaded.
  //
  // `* * * * *` has no syntax left to get wrong, needs no second copy, and
  // leaves four of the account's five slots free.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Non-secret configuration. Secrets are set with `wrangler secret put` --
  // never add TELEGRAM_BOT_TOKEN, ANTHROPIC_API_KEY, DATABASE_URL,
  // MODERATOR_CHAT_ID or TELEGRAM_WEBHOOK_SECRET here.
  "vars": {
    // Haiku 5.5 for drafting. Every draft is read and approved by a
    // moderator before a customer sees it, which is the safety net that makes
    // the cheaper model a reasonable trade -- roughly $0.003 a question
    // against $0.02-0.13 on Opus. Raise this to claude-opus-5-5 if drafts
    // start needing heavy editing. Haiku has no server-side refusal
    // fallback, which src/adapters/claude.ts accounts for by model.
    // Who writes the suggested answer: "workers-ai", "claude", or "none" for
    // a moderator-written reply every time. A provider that cannot run --
    // "claude" with no API key -- degrades to "none" rather than failing the
    // webhook, and /health reports which one is actually in effect.
    // The committed default needs no credential, so a fresh clone always
    // deploys. The "github" route needs a dispatch token, and a default that
    // demands a secret nobody has created yet turns a working deployment into
    // an undeployable one -- which is exactly what it did. Choose the route
    // per deploy with the draft_provider input on the Deploy workflow.
    "DRAFT_PROVIDER": "workers-ai",

    // Only for DRAFT_PROVIDER "github": which repository receives the
    // dispatch. No default -- guessing a repository name would send a ticket
    // ID to someone else's workflow. The token goes in a Worker secret
    // (GITHUB_DISPATCH_TOKEN); this is just the address.
    "GITHUB_REPOSITORY": "alextee2005/ardb-chatbot-mvp",

    // Confirmed 128,000-token context window, which is the binding
    // constraint: the whole corpus (~20,000 tokens) is sent with every
    // question and Workers AI has no prompt cache to put it behind. Works out
    // at roughly 440 neurons a question, so about 22 free questions a day.
    //
    // gpt-oss answers in OpenAI's chat-completions or responses shape, not
    // the plain {response} of the text-generation models, and it reasons on
    // every request from the same output budget as the answer. The adapter
    // reads all three shapes and turns its effort down; a model family in a
    // fourth shape would report "no text in any shape this adapter reads"
    // along with the keys it did get.
    //
    // @cf/meta/llama-3.1-8b-instruct-fp8-fast is far cheaper per input token
    // (~123 neurons a question, ~80 a day) but Cloudflare documents only
    // 32,000 tokens for its non-fast sibling, which leaves little headroom
    // over the corpus. Check the model's page before switching.
    "WORKERS_AI_MODEL": "@cf/openai/gpt-oss-20b",

    "CLAUDE_MODEL": "claude-haiku-5-5",
    "CLAUDE_EFFORT": "low",
    "RATE_LIMIT_PER_MINUTE": "3",
    // Minutes of silence after which a customer's interaction is treated as
    // over: the next question starts a new conversation instead of being
    // drafted as a follow-up, and the old one gets an ended_at.
    "CONVERSATION_IDLE_MINUTES": "60",

    // The ending sequence. 30 quiet minutes after the last activity the bot
    // asks whether anything else is needed; if that question goes unanswered
    // for a further CONVERSATION_IDLE_MINUTES the interaction is recorded as
    // over and the survey goes out. An interaction the customer answers ends
    // when they answer it; an abandoned one is closed 90 minutes after the
    // last activity.
    //
    // FOLLOWUP_MINUTES must stay below CONVERSATION_IDLE_MINUTES + itself for
    // the follow-up to be asked before the conversation is closed. The
    // windows are sequential rather than racing, so this holds for any
    // positive values, and a test asserts it.
    "FOLLOWUP_MINUTES": "30",

    // How long a closed conversation stays in the live tables before the
    // weekly archive moves it to the history tables, and how many are moved
    // per run. Satisfaction survey results are never archived -- they snapshot
    // what they need and outlive the conversation they rate.
    "ARCHIVE_AFTER_DAYS": "7",
    "ARCHIVE_BATCH_SIZE": "200",

    // How long an archived interaction is kept before it is deleted outright.
    // Measured from the date of the interaction itself, not from the day the
    // archive happened to move it. Satisfaction results are deleted on the
    // same clock, measured from when they were given.
    "HISTORY_RETENTION_YEARS": "10",
    "LOG_LEVEL": "info",

    // Minutes of silence before the moderator group is nudged, the minimum
    // gap between repeat nudges, the cap on nudges per ticket, and the point
    // at which the customer is told once that it is taking longer.
    "SLA_NUDGE_AFTER_MINUTES": "10",
    "SLA_NUDGE_REPEAT_MINUTES": "30",
    "SLA_MAX_NUDGES": "3",
    "SLA_WARN_CUSTOMER_AFTER_MINUTES": "45"
  }
}
